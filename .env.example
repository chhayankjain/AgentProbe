# AgentProbe environment variables
# Copy to .env and fill in your values. Never commit .env to git.

# LLM API keys (only needed if using cloud backends)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local) — no key needed, just set base URL if non-default
OLLAMA_BASE_URL=http://localhost:11434

# OpenTelemetry OTLP export (optional — defaults to console only)
AGENTPROBE_OTLP_ENDPOINT=http://localhost:4317

# Disable console span output (set to 1 for CI)
AGENTPROBE_NO_CONSOLE_TRACE=0

# Prometheus exporter port
AGENTPROBE_PROMETHEUS_PORT=8000
